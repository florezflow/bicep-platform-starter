# Renders a component's README.md from its compiled ARM template (the input).
# Called by update-readme.sh with --arg path <component> --arg alias <bicepconfig alias>.
# Everything in the README comes from the compiler: required or not, types, defaults, limits, examples.

def clean: sub("^_[0-9]+\\."; "");                       # transitive imports are named _1.<type>
def anchor: ascii_downcase | gsub("[^a-z0-9_ -]"; "") | gsub(" "; "-");
def cell: gsub("\\s*\n\\s*"; " ") | gsub("\\|"; "\\|") | sub("\\s+$"; "");
def text: sub("\\s+$"; "");
def typename:
  if has("$ref") then (."$ref" | sub("^#/definitions/"; "") | clean) as $n | "[\($n)](#\($n | anchor))"
  elif .type == "array" and has("items") then (.items | typename) + "[]"
  else (.type // "any") end;
def required: (.nullable != true) and (has("defaultValue") | not);
def yesno: if required then "yes" else "no" end;
def value: if type == "string" then "`\(.)`" else "`\(tojson)`" end;
def example: (.metadata.example? // null) | if . == null then empty else "Example: \(value)" end;
def facts:
  [ (if has("defaultValue") then "Default: \(.defaultValue | value)" else empty end),
    (if has("allowedValues") then "Allowed values: \(.allowedValues | map(value) | join(", "))" else empty end),
    (if has("minLength") then "Minimum length: \(.minLength)" else empty end),
    (if has("maxLength") then "Maximum length: \(.maxLength)" else empty end),
    (if has("minValue") then "Minimum value: \(.minValue)" else empty end),
    (if has("maxValue") then "Maximum value: \(.maxValue)" else empty end),
    example ];
def described: [(.metadata.description // "" | cell), ([facts[]] | join(". "))] | map(select(. != "")) | join(" ");
def scope:
  (."$schema" // "") as $s
  | if ($s | test("subscriptionDeploymentTemplate")) then "subscription"
    elif ($s | test("managementGroupDeploymentTemplate")) then "management group"
    elif ($s | test("tenantDeploymentTemplate")) then "tenant"
    else "resource group" end;
def usage:
  "br/\($alias):\($path):v\(.metadata.version)" as $ref
  | if ($path | startswith("solutions/00-init-")) then "deployed once from source: `scripts/deploy-stack.sh \($path | ltrimstr("solutions/"))/<env> deploy`"
    elif ($path | startswith("solutions/")) then "`using '\($ref)'`"
    elif $path == "types" then "`import { … } from '\($ref)'`"
    else "`module m… '\($ref)' = { … }`" end;

. as $t
| ($t.definitions // {} | to_entries | map(.key |= clean) | unique_by(.key)) as $types
| [$t.functions[]?.members // {} | to_entries[] | select(.value.metadata["__bicep_export!"] == true)] as $functions
| [
    "# \(.metadata.name)",
    "",
    (.metadata.description | text),
    "",
    "<!-- Generated by scripts/update-readme.sh from the compiled template. Edit the @description and @metadata decorators instead. -->",
    "",
    "| | |",
    "|---|---|",
    "| Version | `\(.metadata.version)` |",
    "| Use it | \(usage) |",
    (if $path != "types" then "| Deploys at | \(scope) scope |" else empty end),
    "",
    ( if (.parameters // {} | length) > 0 then
        "## Parameters",
        "",
        "| Parameter | Required | Type |",
        "|---|---|---|",
        (.parameters | to_entries[] | "| [\(.key)](#\(.key | anchor)) | \(.value | yesno) | \(.value | typename) |"),
        "",
        (.parameters | to_entries[]
          | "### \(.key)",
            "",
            (.value.metadata.description // "" | text),
            "",
            (.value | typename | "- Type: \(.)"),
            (.value | facts[] | "- \(.)"),
            "")
      else empty end ),
    ( if ($types | length) > 0 then
        "## Types",
        "",
        ($types[]
          | "### \(.key)",
            "",
            (.value.metadata.description // "" | text),
            "",
            ( if .value.type == "object" and (.value | has("properties")) then
                "| Property | Required | Type | Description |",
                "|---|---|---|---|",
                (.value.properties | to_entries[]
                  | "| \(.key) | \(.value | yesno) | \(.value | typename) | \(.value | described) |"),
                ""
              else
                (.value | typename | "- Type: \(.)"),
                (.value | facts[] | "- \(.)"),
                ""
              end ))
      else empty end ),
    ( if ($functions | length) > 0 then
        "## Functions",
        "",
        "| Function | Returns | Description |",
        "|---|---|---|",
        ($functions[]
          | "| `\(.key)(\(.value.parameters | map("\(.name) \(typename | gsub("\\[|\\]\\(#[a-z]+\\)"; ""))") | join(", ")))` | \(.value.output | typename) | \(.value.metadata.description // "" | cell) |"),
        ""
      else empty end ),
    ( if (.outputs // {} | length) > 0 then
        "## Outputs",
        "",
        "| Output | Type | Description |",
        "|---|---|---|",
        (.outputs | to_entries[] | "| \(.key) | \(.value | typename) | \(.value | described) |"),
        ""
      else empty end )
  ]
| .[:-1][]
